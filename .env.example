# Copy to .env at the repo root and fill in. Never commit .env.
MONGODB_URI=
MONGODB_CONNECTION_STRING=
DB_NAME=txn_validation

# LLM / AI Configuration
GOOGLE_API_KEY=
OPENAI_API_KEY=
# "<provider>:<model>" for langchain init_chat_model (or model name if LLM_PROVIDER is set)
LLM_MODEL=google_genai:gemini-2.5-flash

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=txn-validation
